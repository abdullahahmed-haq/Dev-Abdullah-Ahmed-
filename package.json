{
  "name": "my-profile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run typecheck && npm run build:vinext",
    "start": "npm run start:vinext",
    "test": "node --conditions=react-server --import tsx --test",
    "test:watch": "node --conditions=react-server --import tsx --test --watch",
    "typecheck": "next typegen && tsc --noEmit",
    "import:legacy": "tsx scripts/import-legacy-content.ts",
    "adapter:check": "vinext check",
    "build:next": "next build",
    "start:next": "next start",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:preview": "node scripts/deploy-preview.mjs",
    "deploy:watch": "node scripts/watch-and-deploy.mjs",
    "check": "npm test && npm run typecheck && npm run adapter:check",
    "verify": "npm run check && npm run build:vinext",
    "predeploy": "npm run verify",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "deploy:vinext": "npm run deploy"
  },
  "dependencies": {
    "@blocknote/core": "0.54.0",
    "@blocknote/mantine": "0.54.0",
    "@blocknote/react": "0.54.0",
    "@mantine/core": "8.3.11",
    "@mantine/hooks": "8.3.11",
    "@portfolio/blog-authoring": "file:packages/blog-authoring",
    "@supabase/ssr": "0.12.5",
    "@supabase/supabase-js": "2.112.4",
    "@vinext/cloudflare": "^1.0.0-beta.6",
    "framer-motion": "^13.1.1",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "^19.2.8",
    "server-only": "0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitejs/plugin-rsc": "^0.5.34",
    "esbuild": "0.28.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.8",
    "vite": "^8.2.2",
    "wrangler": "^4.126.0"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}
