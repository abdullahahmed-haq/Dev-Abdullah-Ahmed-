        "en": {
          "locale": "en",
          "state": "published",
          "slug": "from-an-idea-to-an-interface",
          "title": "From an idea to an interface with its own voice",
          "excerpt": "Turning early notes into a calm, clear digital experience that people can actually use.",
          "category": "Design",
          "tags": [
            "Interface design",
            "Process",
            "UX"
          ],
          "cover": "https://images.unsplash.com/photo-1558655146-d09347e92766?auto=format&fit=crop&w=1600&q=85",
          "coverAlt": "A warm desk with design notes",
          "seoTitle": "",
          "seoDescription": "",
          "scheduledAt": "",
          "publishedAt": "2026-08-18T09:00:00.000Z",
          "featured": true,
          "blocks": [
            {
              "id": "en-idea-h",
              "type": "heading",
              "text": "Start with the right question",
              "level": 2
            },
            {
              "id": "en-idea-p",
              "type": "paragraph",
              "text": "A screen should not begin with a component library. It should begin with what a person needs to understand, do, and remember.",
              "level": 2
            },
            {
              "id": "en-idea-q",
              "type": "quote",
              "text": "Clarity is not the absence of personality. It is personality that knows when to be quiet.",
              "level": 2
            },
            {
              "id": "en-idea-list",
              "type": "list",
              "ordered": true,
              "items": [
                "State the goal in one sentence.",
                "Arrange information before styling it.",
                "Test the rhythm, not only the surface."
              ]
            }
          ]
        }
      }
    },
    {
      "id": "digital-archive-notes",
