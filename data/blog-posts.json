          "slug": "building-a-reusable-editorial-block",
          "title": "Building a reusable editorial block",
          "excerpt": "A small lesson in separating content from presentation in a flexible article interface.",
          "category": "Development",
          "tags": [
            "React",
            "Components",
            "Tutorial"
          ],
          "cover": "",
          "coverAlt": "",
          "seoTitle": "",
          "seoDescription": "",
          "scheduledAt": "",
          "publishedAt": "2026-08-24T09:00:00.000Z",
          "featured": false,
          "blocks": [
            {
              "id": "lesson-en-p",
              "type": "paragraph",
              "text": "The core idea is simple: store content as data, then let a trusted block renderer decide how to show it.",
              "level": 2
            },
            {
              "id": "lesson-en-code",
              "type": "code",
              "code": "const renderer = renderers[block.type] || renderers.paragraph\nreturn renderer(block)",
              "language": "js",
              "filename": "blocks.js"
            },
            {
              "id": "lesson-en-quote",
              "type": "quote",
              "text": "A good abstraction gives authors more room while giving the renderer less to fear.",
              "level": 2
            }
          ]
        }
      }
