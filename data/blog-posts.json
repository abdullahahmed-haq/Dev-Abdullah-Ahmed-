      "updatedAt": "2026-08-22T09:00:00.000Z",
      "locales": {
        "en": {
          "locale": "en",
          "state": "published",
          "slug": "designing-interfaces-that-feel-quiet",
          "title": "Designing interfaces that feel quiet",
          "excerpt": "Quiet interfaces make room for intent, not emptiness. Here is how I look for that balance.",
          "category": "Design",
          "tags": [
            "Visual design",
            "Calm technology",
            "Typography"
          ],
          "cover": "https://images.unsplash.com/photo-1499750310107-5fef28a66643?auto=format&fit=crop&w=1600&q=85",
          "coverAlt": "A laptop and notebook beside a window",
          "seoTitle": "",
          "seoDescription": "",
          "scheduledAt": "",
          "publishedAt": "2026-08-22T09:00:00.000Z",
          "featured": false,
          "blocks": [
            {
              "id": "quiet-p",
              "type": "paragraph",
              "text": "A quiet interface has enough contrast to guide you, enough structure to make decisions easy, and enough empty space to let the work breathe.",
              "level": 2
            },
            {
              "id": "quiet-h",
              "type": "heading",
              "text": "Silence is an interaction decision",
              "level": 2
            },
            {
              "id": "quiet-callout",
              "type": "callout",
              "text": "Remove anything that competes with the next meaningful action.",
              "level": 2
            }
          ]
        }
      }
    },
